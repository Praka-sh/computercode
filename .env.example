# Company Brain MVP - Environment Variables
# Copy this to .env and fill in values. NEVER commit .env

# ===========================================
# Application
# ===========================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# ===========================================
# Database
# ===========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=company_brain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/company_brain

# ===========================================
# Redis / Celery
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ===========================================
# MinIO / S3
# ===========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=company-brain
S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# ===========================================
# Authentication
# ===========================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# AI Provider (choose one)
# ===========================================
# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI (optional)
OPENAI_API_KEY=sk-...
# Embedding model
EMBEDDING_PROVIDER=anthropic
EMBEDDING_MODEL=voyage-3-large
EMBEDDING_DIMENSIONS=1024

# ===========================================
# ERPNext Sandbox (for M5)
# ===========================================
ERPNEXT_SANDBOX_URL=https://your-sandbox.erpnext.com
ERPNEXT_API_KEY=your-api-key
ERPNEXT_API_SECRET=your-api-secret

# ===========================================
# Logging / Observability
# ===========================================
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com